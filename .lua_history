local f = loadstring('gX = 100 + 200')
f()
assert(gX == 300)
local env = {answer = 123}
local co = coroutine.create(function()
  local yielded = getfenv(0)
  print('yield-is-env', yielded == env)
  coroutine.yield(yielded)
  local f, err = loadstring('return answer')
  print('loadstring-f', type(f), err)
  return f()
end)
print('setfenv', debug.setfenv(co, env) == co)
print('getfenv', debug.getfenv(co) == env)
local ok1, yielded = coroutine.resume(co)
print('resume1', ok1, yielded == env)
local ok2, value = coroutine.resume(co)
print('resume2', ok2, value)
