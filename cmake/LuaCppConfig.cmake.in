@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/LuaCppTargets.cmake")

set(_lua_cpp_imported_targets LuaCpp::Lua)
if(TARGET LuaCpp::Shared)
    list(APPEND _lua_cpp_imported_targets LuaCpp::Shared)
endif()

if(CMAKE_VERSION VERSION_GREATER_EQUAL "3.23")
    foreach(_lua_cpp_imported_target IN LISTS _lua_cpp_imported_targets)
        set_property(TARGET "${_lua_cpp_imported_target}" PROPERTY IMPORTED_NO_SYSTEM TRUE)
    endforeach()
else()
    # IMPORTED_NO_SYSTEM was added in CMake 3.23. For supported CMake
    # 3.20-3.22 consumers, move the include interface to a normal provider
    # target so the compiler still receives an ordinary, precedence-preserving
    # include directory rather than a system include.
    set(_lua_cpp_include_directories "")
    foreach(_lua_cpp_imported_target IN LISTS _lua_cpp_imported_targets)
        get_target_property(
            _lua_cpp_target_include_directories
            "${_lua_cpp_imported_target}"
            INTERFACE_INCLUDE_DIRECTORIES
        )
        if(_lua_cpp_target_include_directories)
            list(APPEND _lua_cpp_include_directories ${_lua_cpp_target_include_directories})
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _lua_cpp_include_directories)

    if(_lua_cpp_include_directories)
        string(MD5 _lua_cpp_package_id "${CMAKE_CURRENT_LIST_DIR}")
        set(_lua_cpp_header_provider "_LuaCpp_non_system_headers_${_lua_cpp_package_id}")
        if(NOT TARGET "${_lua_cpp_header_provider}")
            add_library("${_lua_cpp_header_provider}" INTERFACE)
            target_include_directories(
                "${_lua_cpp_header_provider}"
                INTERFACE
                    ${_lua_cpp_include_directories}
            )
        endif()

        foreach(_lua_cpp_imported_target IN LISTS _lua_cpp_imported_targets)
            set_property(
                TARGET "${_lua_cpp_imported_target}"
                PROPERTY INTERFACE_INCLUDE_DIRECTORIES ""
            )
            set_property(
                TARGET "${_lua_cpp_imported_target}"
                APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${_lua_cpp_header_provider}"
            )
        endforeach()
    endif()
endif()

unset(_lua_cpp_header_provider)
unset(_lua_cpp_package_id)
unset(_lua_cpp_target_include_directories)
unset(_lua_cpp_include_directories)
unset(_lua_cpp_imported_target)
unset(_lua_cpp_imported_targets)

check_required_components(LuaCpp)
